# Frontend
VITE_API_URL=/api

# Backend
APP_ENV=development
FRONTEND_ORIGIN=http://localhost:5000
INCIDENT_DATABASE_URL=sqlite:///./database/incident_commander.db
KNOWLEDGE_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
KNOWLEDGE_EMBEDDING_CACHE=.cache/fastembed
KNOWLEDGE_CHUNK_SIZE_WORDS=180
KNOWLEDGE_CHUNK_OVERLAP_WORDS=30

# Phase 6: configure GEMINI_API_KEY in Replit Secrets; never commit its value.
GEMINI_MODEL=gemini-2.5-flash
ROOT_CAUSE_RAG_TOP_K=5
ROOT_CAUSE_MAX_EVIDENCE_CHARS=12000
ROOT_CAUSE_MAX_LOG_CHARS=500
ROOT_CAUSE_MAX_PROMPT_CHARS=20000
ROOT_CAUSE_MAX_LOG_EVENTS=30
ROOT_CAUSE_TIMEOUT_SECONDS=20
ROOT_CAUSE_CACHE_TTL_SECONDS=300
ROOT_CAUSE_CACHE_MAX_ENTRIES=128
